VERSION=0.3.11-alpha
NODE_ENV=development

## BUILD STAMP
# Identifies the build, so an open browser tab can tell that the server is now
# serving a different one and reload itself. Leave it empty for normal use: a
# host build reads the commit from git, and an image build falls back to VERSION
# plus a timestamp.
#
# Worth setting when you build images, because .git is not in the build context:
#
#   VANTIK_BUILD_ID=$(git rev-parse --short HEAD) docker compose build
#
# With it, rebuilding the same commit keeps the same asset URLs and nobody is
# asked to reload for a build that did not change.
VANTIK_BUILD_ID=
VANTIK_COMMIT=


############# Common ###############
## LOGGER
# The server logs JSON to stdout. LOG_LEVEL sets the floor.
LOG_LEVEL=debug

## OPENTELEMETRY
# Telemetry is off unless an endpoint is set. Leave this empty and the SDK is
# never started: no instrumentation, no overhead, nothing leaves the process.
# This is the default for self-hosted installs.
#
# One endpoint covers all three signals — traces, metrics and logs. Logs still
# go to stdout as JSON regardless; setting this adds a second copy over OTLP, it
# does not move them.
#
# For a local Grafana with dashboards already provisioned, do not set this by
# hand — start the observability overlay, which sets it for you:
#
#   docker compose -f docker-compose.yaml -f docker-compose.observability.yaml up -d
#
# Grafana is then on http://localhost:3002. Only set the variable yourself if you
# run the apps on the host with `pnpm dev`, in which case use
# http://localhost:4318 so the exporter reaches the overlay's published port.
#
# Set it to an OTLP/HTTP collector to get traces, metrics and logs. Traces
# cover the Postgres, Redis and Prisma calls under each request and put trace
# ids on every log line; metrics cover request rate/errors/duration per route
# plus Node event loop, heap and GC; logs arrive with the same correlation ids
# the stdout copy carries. Any OTLP backend works (Grafana Tempo/Mimir/Loki,
# Honeycomb, Jaeger, Sentry, a local collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# Auth headers for hosted collectors, read by the exporter directly.
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...
#
# How often metrics are pushed, in milliseconds. Defaults to 60000. Metrics are
# cumulative, so a longer interval costs resolution, not data.
# OTEL_METRIC_EXPORT_INTERVAL=60000
#
# Set to debug/info/warn/error to surface the SDK's own diagnostics, which are
# otherwise silent — useful when an endpoint is set but no spans arrive.
# OTEL_LOG_LEVEL=

# POSTGRES
POSTGRES_USER=docker
POSTGRES_PASSWORD=docker
POSTGRES_DB=vantik

# Nest run in docker, change host to database container name
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=vantik

REDIS_URL=localhost
REDIS_PORT=6379
REDIS_TLS_DISABLED=true

FRONTEND_HOST=http://localhost:3000
BACKEND_HOST=http://localhost:3001
BACKEND_URL=http://localhost:3001

OAUTH_CALLBACK_URL=${FRONTEND_HOST}/api/v1/oauth/callback

# Passkeys are bound to the hostname in FRONTEND_HOST, so an install reached on
# a different domain than it was registered on will not see its passkeys.
# Set this to false to stop a passkey from creating a brand new account: people
# then arrive through an invite or a login code and add a passkey afterwards.
PASSKEY_SIGNUP_ENABLED=true

# Lets an operator sign in as any user from /x/admin, to see what they see.
# Leave it empty and that is switched off. If you set it, make it long and
# random, and keep it apart from every other secret here.
# IMPERSONATION_KEY=
############# Server ###############
# Prisma database connection
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}?schema=${DB_SCHEMA}&sslmode=prefer

BACKEND_PORT=3001
SUPERTOKEN_CONNECTION_URI=http://localhost:3567

# Encrypts the model keys and git tokens that agent runs use. Required: the
# server does not start without it. Make one and add it to this file with
#
#   echo "CREDENTIAL_ENCRYPTION_KEY=$(openssl rand -base64 32)" >> .env
#
# Then keep it. A server started with a different key cannot read the
# credentials already saved, and each workspace has to enter them again.
# CREDENTIAL_ENCRYPTION_KEY=

# These are used by server to talk to typesense
TYPESENSE_API_KEY=random_API_key
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# Where uploaded files go.
#
#   local  files on a disk the server mounts. This is the default, and it needs
#          no other setting. Compose keeps them in the attachment-data volume.
#   s3     Amazon S3, or any store that answers the S3 protocol: Cloudflare R2,
#          MinIO, DigitalOcean Spaces, Backblaze B2, Wasabi, and Google Cloud
#          Storage through its interoperability endpoint.
#
# An empty value means local. A name the server does not have stops the server
# at startup, and so does a backend with settings missing.
STORAGE_PROVIDER=

# --- local ---
# Where the files sit. The default is /data/attachments, which compose mounts
# as a volume. Change it only if you mount somewhere else.
# LOCAL_STORAGE_PATH=/data/attachments

# Signs the attachment URLs the local backend gives out. Leave it empty and the
# server makes one on first start and keeps it beside the files, which is what
# you want for a single installation. Set it when several servers share one
# volume, or when you would rather hold the secret yourself.
# ATTACHMENT_URL_SECRET=

# --- s3 and every store that speaks its protocol ---
# BUCKET_NAME=vantik-attachments
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Leave the key and secret empty on a host that already has credentials, such
# as one with an instance role. The AWS SDK finds them the usual way.
#
# S3_ENDPOINT is what points this backend at a store other than Amazon. Leave
# it empty for Amazon S3 itself.
#
#   Cloudflare R2   https://<account-id>.r2.cloudflarestorage.com   AWS_REGION=auto
#   MinIO           http://minio:9000
#   Google Cloud    https://storage.googleapis.com                  AWS_REGION=auto
#   Spaces          https://<region>.digitaloceanspaces.com
#
# S3_ENDPOINT=
#
# Path style puts the bucket in the path and not in the host name. It turns on
# by itself once S3_ENDPOINT is set, because most other stores need it. Set it
# only to say otherwise.
# S3_FORCE_PATH_STYLE=

# Email settings. Sign-in codes and notifications go through this server.
# The connection upgrades with STARTTLS when the server offers it (port 587);
# SMTP_USE_SLS=true asks for implicit TLS instead (port 465).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USE_SLS=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_DEFAULT_FROM=

## AI
# Powers title generation, summaries, filters, sub-issues and delegation
# suggestions. Any OpenAI-compatible endpoint works — OpenRouter, LM Studio,
# Ollama, vLLM, or OpenAI itself — so switching provider is config, not code.
#
# Leave these unset and the interface leaves the AI features out entirely
# rather than offering buttons that cannot work. Set them later and they appear
# on the next page load — the browser reads this at runtime, no rebuild.
#
#   OpenRouter    https://openrouter.ai/api/v1        (a real key)
#   OpenAI        https://api.openai.com/v1           (a real key)
#   LM Studio     http://localhost:1234/v1            (any placeholder key)
#   Ollama        http://localhost:11434/v1           (any placeholder key)
#
# Local servers ignore the key but still need one sent, hence the placeholder.
#
# Left blank on purpose. Shipping one of the URLs above already filled in is
# how a key for one vendor ends up sent to another: the key line is the one
# people fill in without reading the line above it. Set both together.
LLM_BASE_URL=
LLM_API_KEY=

# Callers ask for a role, never a model. Point each role at whatever this
# install wants to pay for; the ids are whatever LLM_BASE_URL serves — the two
# below are OpenRouter's, and are wrong for any other endpoint.
LLM_MODEL_FAST=openai/gpt-4o-mini
LLM_MODEL_SMART=openai/gpt-4o

# Optional, and only OpenRouter reads them: they attribute usage to your app on
# its dashboard and public leaderboards. Every other endpoint ignores them.
# LLM_APP_URL=https://vantik.example.com
# LLM_APP_NAME=Vantik

# MCP endpoint rate limit, counted per personal access token so one runaway
# agent cannot starve the others. Counters are per server process, so with
# several replicas the real ceiling is this times the replica count. Set
# MCP_RATE_LIMIT=0 to turn the limit off, e.g. behind your own limiter.
MCP_RATE_LIMIT=120
MCP_RATE_LIMIT_WINDOW_MS=60000

############# Frontend ###############
# The browser reads these from the server at /api/v1/config when the app loads,
# so they take effect on container restart - no rebuild needed.

# Origin the browser reaches the server on, for the websocket connection. The
# websocket is not proxied through the webapp, so this cannot be a path.
# Everything else the frontend calls goes through /api on its own origin.
NEXT_PUBLIC_BACKEND_HOST=${BACKEND_HOST}

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# You need to set your domain if self-hosted
PUBLIC_ATTACHMENT_URL=http://localhost:3000/api

# You can add your sentry to get the errors from the application.
# Leave empty to disable; this must be a real Sentry DSN, not a host.
NEXT_PUBLIC_SENTRY_DSN=

############# Scheduled work ###############
# Bull repeatable jobs inside the server, on the Redis above. Set either to
# `off` to disable. See "Scheduled work" in README.md.

# Completes ended cycles and tops up upcoming ones for teams on the automatic
# cadence. Hourly, because a cycle's end date carries a time of day.
CYCLE_MAINTENANCE_CRON=0 * * * *

############# Knowledge ###############
# The knowledge bank's settings. Each has the default shown, and a workspace
# can set its own under `knowledge` in its preferences (the same names in
# camelCase: holdoutRate, contextTopK, contextTokenBudget, autoTriage,
# similarityThreshold, auditRate, kappaFloor, kappaMinSamples,
# kappaWindowDays, conventionMinRuns, conventionHarmMargin, gapIssueMinCount,
# gapIssuesCron, pageRefreshMinInterval), which wins over these. A value that cannot be read is ignored and the default applies.

# The share of agent runs handed no knowledge, from 0 to 1, so the runs that
# were can be compared with the runs that were not (Settings -> Agents). 0
# hands every run the knowledge and measures nothing.
# KNOWLEDGE_HOLDOUT_RATE=0.1

# How many relevant, grounded or person-verified entries a run is handed after
# its modules' conventions, and the tokens all of it may take (at most 20000).
# KNOWLEDGE_CONTEXT_TOP_K=5
# KNOWLEDGE_CONTEXT_TOKEN_BUDGET=1500

# Whether triage decides about agents' new entries before a person does: off,
# shadow (decide and record every decision, change nothing) or on (accept,
# fold in repeats and reject as decided; escalations still wait for a person).
# Leave it on shadow until its decisions agree with the people triaging.
# KNOWLEDGE_AUTO_TRIAGE=shadow

# How alike two entries must be, from 0 to 1, before triage asks a model how
# they relate. Below it they are taken to be different facts.
# KNOWLEDGE_SIMILARITY_THRESHOLD=0.25

# The share of what triage accepts, folds in or rejects on its own (in `on`
# mode) that is put in front of a person to check, from 0 to 1.
# KNOWLEDGE_AUDIT_RATE=0.1

# Agreement between triage and people, as Cohen's kappa per decision type over
# the verdicts of the last KNOWLEDGE_KAPPA_WINDOW_DAYS days. A type whose kappa
# falls under the floor, over at least the minimum number of verdicts, stops
# acting and sends its entries to a person until agreement recovers.
# KNOWLEDGE_KAPPA_FLOOR=0.6
# KNOWLEDGE_KAPPA_MIN_SAMPLES=20
# KNOWLEDGE_KAPPA_WINDOW_DAYS=30

# A review finding given in this many separate agent runs in one module is
# proposed as a convention there; a person decides whether to accept it. A
# convention proposed this way is taken out of use (archived, and a person
# can put it back) once its harmful outcomes outnumber its helpful ones by the
# margin, counted since a person last put it back.
# KNOWLEDGE_CONVENTION_MIN_RUNS=3
# KNOWLEDGE_CONVENTION_HARM_MARGIN=3

# A question the knowledge could not answer, asked at least this many times,
# gets an issue asking a person to answer it, once, on the team that owns the
# module the question names. The job runs on the schedule below (weekly, on
# Monday at 04:00, by default; `off` disables it). A workspace can switch it
# off for itself with gapIssuesCron set to `off`, but not move it: one job
# serves every workspace. The question counts as answered once an entry that
# cites its issue is accepted.
# KNOWLEDGE_GAP_ISSUE_MIN_COUNT=5
# KNOWLEDGE_GAP_ISSUES_CRON=0 4 * * 1

# A generated page is rebuilt from the entries it cites once they have changed
# since its last build, and no sooner than this after that build: a duration
# such as 90m, 6h or 1d. The job that looks for pages to rebuild runs on the
# schedule below (hourly, by default; `off` disables it, and generated pages
# are then built only when they are made or their question changes, the
# latter once the minimum interval since the last build has passed; a build
# that fails twice, because the index or the model cannot be reached, is not
# tried again).
# KNOWLEDGE_PAGE_REFRESH_MIN_INTERVAL=6h
# KNOWLEDGE_PAGE_REFRESH_CRON=23 * * * *
