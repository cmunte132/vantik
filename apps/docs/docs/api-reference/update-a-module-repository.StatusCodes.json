{"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","description":"Where the code of a module is. If `pathPrefixes` is empty, the module is the full repository. A monorepo becomes several modules on one repository, and each module has its own prefixes.","properties":{"id":{"type":"string"},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"deleted":{"type":"string","format":"date-time","nullable":true},"moduleId":{"type":"string"},"integrationAccountId":{"type":"string","nullable":true},"externalRepoId":{"type":"string"},"fullName":{"type":"string","description":"\"owner/name\" on the provider."},"pathPrefixes":{"type":"array","items":{"type":"string"}},"bidirectional":{"type":"boolean"},"isDefault":{"type":"boolean"}},"title":"ModuleRepo"}}}},"401":{"description":"Unauthorized"},"404":{"description":"Not found"}}}