{"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","description":"A module is usually one repository. It can also be a path in a repository, or one service. A module has one owner only, and that owner is a team or a product. The lists of links name the other teams and the other products that use the module. A link gives no authority over the module.","properties":{"id":{"type":"string"},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"deleted":{"type":"string","format":"date-time","nullable":true},"name":{"type":"string"},"key":{"type":"string","description":"A short name, for example \"server\". Unique in the workspace."},"description":{"type":"string","nullable":true},"status":{"type":"string","nullable":true},"icon":{"type":"string","nullable":true},"color":{"type":"string","nullable":true},"leadUserId":{"type":"string","nullable":true},"ownerTeamId":{"type":"string","nullable":true},"ownerProductId":{"type":"string","nullable":true},"linkedTeamIds":{"type":"array","items":{"type":"string"}},"linkedProductIds":{"type":"array","items":{"type":"string"}},"workspaceId":{"type":"string"}},"title":"Module"}}}},"400":{"description":"Two owners, or no owner"},"401":{"description":"Unauthorized"},"404":{"description":"Not found"}}}