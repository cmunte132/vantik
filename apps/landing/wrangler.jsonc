// Cloudflare Workers Builds deploys this site with `npx wrangler deploy`. The
// Worker has no script: it serves the Astro build output as static assets,
// and applies public/_redirects. The custom domain vantik.dev is set in the
// Cloudflare dashboard, not here.
{
  "name": "vantik",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
