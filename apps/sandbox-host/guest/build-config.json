{
  "distro": "alpine",
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "rootfsPackages": [
      "linux-virt",
      "rng-tools",
      "bash",
      "ca-certificates",
      "curl",
      "e2fsprogs",
      "e2fsprogs-extra",
      "git",
      "nodejs",
      "npm",
      "openssh",
      "python3",
      "ripgrep",
      "uv",
      "ast-grep",
      "fd",
      "jq"
    ],
    "initramfsPackages": [],
    "krunfwVersion": "v5.2.1"
  },
  "rootfs": {
    "label": "gondolin-root"
  },
  "postBuild": {
    "commands": [
      "npm install -g --no-fund --no-audit --omit=dev @earendil-works/pi-coding-agent@${PI_VERSION} typescript@5.9.3 typescript-language-server@6.0.1 pyright@1.1.414",
      "npm cache clean --force",
      "mkdir -p /opt/vantik && echo ${PI_VERSION} > /opt/vantik/pi-version"
    ]
  }
}
