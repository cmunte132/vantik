{
  "name": "sandbox-host",
  "version": "2026.9.0",
  "private": true,
  "description": "Runs the microVMs that Vantik's hosted agent runs work in, apart from the server",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "build:guest": "node guest/build.mjs",
    "dev": "tsup --watch --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@earendil-works/gondolin": "0.12.0"
  },
  "devDependencies": {
    "@vantikhq/eslint-config": "workspace:*",
    "@vantikhq/types": "workspace:*",
    "@vantikhq/typescript-config": "workspace:*",
    "@types/node": "^20.11.5",
    "eslint": "^8.56.0",
    "rimraf": "^3.0.2",
    "tsup": "^8.0.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
