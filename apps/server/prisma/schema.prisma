/// What a page has been linked to.
///
/// Polymorphic rather than one nullable column per kind, because the set of
/// things worth relating a page to grows — a cycle, a label, a customer — and
/// each new one would otherwise be a migration plus a branch in every query
/// that walks the graph.
enum PageLinkType {
  TEAM
  PROJECT
  ISSUE
  /// Page to page. Bodies can already mention each other in prose, but prose is
  /// not traversable and says nothing in the other direction.
  PAGE
  /// The product graph. What a workspace ships, where the code is, and what
  /// the software does are the things documentation is most often *about*,
  /// and the ones an agent grounded in an issue already holds ids for.
  PRODUCT
  MODULE
  CAPABILITY
}

/// An edge between a page and something else in the workspace.
///
/// Nesting gives a page exactly one parent, which is the wrong shape for "this
/// runbook belongs to the Payments project and the Platform team". This is the
/// shape that answers that, and it is what lets an agent holding an issue find
/// the documentation for it instead of guessing search terms.
model PageLink {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  page   Page   @relation(fields: [pageId], references: [id])
  pageId String

  entityType PageLinkType
  /// Deliberately not a foreign key: one column cannot reference four tables.
  /// The cost is that a dangling edge is possible, so reads resolve targets and
  /// drop the ones that no longer exist rather than trusting the row.
  entityId   String

  createdById String?

  /// The same edge twice is not two facts about the graph.
  @@unique([pageId, entityType, entityId])
  @@index([pageId])
  /// The reverse direction, and the reason this is a graph rather than a list:
  /// "what pages relate to this issue" has to be a lookup, not a scan of every
  /// issue body in the workspace.
  @@index([entityType, entityId])
}

/// How strictly a page polices appended entries.
///
/// The failure mode this exists for is not one badly-behaved agent; it is ten
/// well-behaved ones each appending the same six facts, because rediscovering
/// those facts is exactly what a memory bank exists to prevent. Asking agents to
/// be tidy in a tool description is the weakest control available — it fails
/// precisely when a cheaper or unfamiliar model is pointed at the endpoint,
/// which is the cross-harness case this feature exists to serve.
enum PageEntryPolicy {
  /// Append freely. Scratch pages, where volume does not matter.
  OPEN
  /// Dedup and the per-token budget are enforced. The default.
  CURATED
  /// Human-only. Agents read the page but cannot append to it.
  LOCKED
}

enum PageEntryKind {
  /// Something true about the system. The default.
  FACT
  /// A choice that was made, and why. The why is the part worth keeping.
  DECISION
  /// How things are done here: a rule a newcomer would not guess.
  CONVENTION
  /// Something that cost somebody time, so it should not cost the next one.
  GOTCHA
}

enum PageEntryCitationKind {
  /// Lines of a file in a module's repository, at a commit.
  CODE
  ISSUE
  PULL_REQUEST
  COMMENT
  RUN
}

/// How an entry reached a reader.
enum PageEntryUseVia {
  /// Packed into a run's context when it was delegated.
  CONTEXT_PACK
  /// Returned by a search (`recall`).
  RECALL
  /// Returned by a budgeted load (`load_context`).
  LOAD_CONTEXT
}

/// What produced an outcome signal.
enum PageEntrySignalSource {
  /// The run's own end: its checks and its review.
  RUN
  /// The pull request the run opened, merged or closed.
  PULL_REQUEST
}

enum PageEntrySignalKind {
  HELPFUL
  HARMFUL
}

/// What triage decided about an entry.
enum KnowledgeTriageDecisionType {
  /// Every condition held; the entry is accepted without a person.
  AUTO_ACCEPT
  /// It says what an existing entry already says; the existing one counts it.
  CORROBORATE
  /// Something only a person can settle; the reasons say what.
  ESCALATE
  /// It breaks a policy outright.
  REJECT
}

/// Why an entry was left for a person.
enum KnowledgeEscalationReason {
  /// It contradicts an entry a person verified.
  CONTRADICTS_VERIFIED
  /// It contradicts an entry on a page maintained by hand.
  CONTRADICTS_LOCKED
  /// It cites nothing.
  UNGROUNDED
  /// A citation does not hold, or has not been read.
  CITATION_FAILED
  /// A convention, which every run in its modules is handed.
  PIN_REQUEST
  /// It declares it replaces an entry, which only a person's acceptance
  /// retires.
  SUPERSEDE_REQUEST
  /// Its scope reaches more modules than one fact should.
  BROAD_SCOPE
  /// The two judgments did not both accept it, or classified a pair apart.
  JUDGES_DISAGREE
  /// A model was needed and none is configured.
  NO_LLM
  /// The run that wrote it worked on an issue from outside the workspace, or
  /// it rests on an issue or comment that came from outside.
  EXTERNAL_INPUT
  /// Not written by a person. Runs do not write with a credential of their
  /// own yet, so what an agent had read cannot be checked for outside input.
  UNKNOWN_SOURCE
  /// Runs it was served to went wrong where it speaks.
  HARMFUL_SIGNAL
  /// A sample of what was accepted, for a person to check.
  AUDIT
  /// People have lately disagreed with decisions of the type it reached, so
  /// a person decides instead (see KnowledgeBackoffChange).
  LOW_AGREEMENT
}

/// What the gardener did to an entry, or asks a person to do.
enum PageEntryMaintenanceAction {
  /// Taken out of use as DISPUTED, with a correction issue opened.
  DISPUTED
  /// Archived.
  ARCHIVED
  /// A person is asked to archive it.
  ARCHIVE_PROPOSED
}

/// Why the gardener changed an entry, or proposes to.
enum PageEntryMaintenanceReason {
  /// A change to the code left a cited snippet changed, and a judge found the
  /// code now contradicts the claim.
  CITATION_CONTRADICTED
  /// A change to the code removed a cited file.
  CITATION_MISSING
  /// A change to the code left a cited snippet changed, and no judge could
  /// say whether the claim still holds.
  CITATION_UNJUDGED
  /// Neither served nor found to hold by a check within the decay window.
  UNUSED
  /// A candidate convention whose harmful outcomes outnumber its helpful ones
  /// by the margin.
  HARMFUL_SIGNALS
}

/// Where a proposal to a person stands.
enum PageEntryProposalState {
  OPEN
  ACCEPTED
  DECLINED
}

/// What a person did with an entry triage had decided about.
enum KnowledgeVerdict {
  /// Kept it as written.
  ACCEPTED
  /// Took it out of use: archived or disputed it.
  REJECTED
  /// Changed what it says, where it applies, or its kind.
  EDITED
}

/// The policy a rejected entry broke.
enum KnowledgeTriagePolicy {
  /// It contains what looks like a credential.
  SECRET
  /// It is several claims in one entry.
  ONE_FACT
}

/// Whether triage acted on its decisions when it made them.
enum KnowledgeTriageMode {
  SHADOW
  ON
}

/// How a newer entry relates to an existing one.
enum PageEntryRelationType {
  /// Says the same thing.
  DUPLICATE
  /// Adds detail to it without disagreeing.
  REFINES
  /// Says it is no longer so.
  SUPERSEDES
  /// Says the opposite.
  CONTRADICTS
  /// A different fact.
  DISTINCT
}

/// What decided a relation.
enum PageEntryRelationDecider {
  /// The same content hash.
  HASH
  /// A rule in code: the two differ in a number, date, negation or condition.
  RULE
  /// Two model judgments that agreed.
  MODEL
}

/// Whether a run was handed the workspace's knowledge.
enum KnowledgeArm {
  TREATMENT
  HOLDOUT
}

enum AgentRunPullRequestOutcome {
  MERGED
  /// Closed without merging.
  CLOSED
}

enum PageEntryCitationCheck {
  /// The cited lines read the same. For a non-code citation: it exists.
  HOLDS
  /// The cited lines read the same elsewhere in the file.
  MOVED
  /// The cited lines are no longer in the file.
  CHANGED
  /// The file, or the non-code target, is gone.
  MISSING
  /// The source could not be reached. Retried; never counts as a failure.
  UNKNOWN
}

enum PageEntryCitationJudgment {
  HOLDS
  CONTRADICTED
  UNCLEAR
}

enum PageEntryStatus {
  /// Awaiting triage. An inbox, never served.
  PROPOSED
  /// True, too granular for prose, and worth retrieving. The only status
  /// retrieval serves.
  STANDING
  /// Folded into the page body. Must stop being served separately, or the same
  /// fact comes back twice.
  CONSOLIDATED
  /// Replaced by a newer entry. Kept for audit, never served.
  SUPERSEDED
  /// Contradicts the body or another entry. Withheld until resolved.
  DISPUTED
  /// Aged out — either never triaged or never read.
  ARCHIVED
}

