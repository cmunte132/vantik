datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // previewFeatures = []
}

model Action {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name         String
  description  String?
  slug         String
  integrations String[]

  status  ActionStatus
  version String
  url     String?

  // To define if the action is deployed in personal account
  isPersonal Boolean @default(false)

  // We store the config of the action
  config Json

  // This is used to store inputs or some data needed for the action 
  data Json?

  workspace    Workspace?     @relation(fields: [workspaceId], references: [id])
  workspaceId  String?
  actionEntity ActionEntity[]

  createdById    String
  actionSchedule ActionSchedule[]
}

model ActionEntity {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  type   String
  entity String

  action   Action @relation(fields: [actionId], references: [id])
  actionId String

  @@unique([type, entity, actionId])
}

model ActionEvent {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  eventType String
  modelName String // Issue
  modelId   String // Issue ID
  eventData Json? // Update data change

  sequenceId BigInt

  processed    Boolean   @default(false)
  processedAt  DateTime?
  processedIds String[]

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String
}

model ActionSchedule {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  cron       String?
  scheduleId String?
  status     ActionScheduleStatus
  timezone   String?

  scheduledById String
  action        Action @relation(fields: [actionId], references: [id])
  actionId      String

  @@unique([actionId, cron, timezone])
}

model Attachment {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  fileName       String?
  originalName   String
  fileType       String
  fileExt        String
  size           Int
  url            String?
  status         AttachmentStatus
  sourceMetadata Json?

  uploadedBy   User?      @relation(fields: [uploadedById], references: [id])
  uploadedById String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id])
  workspaceId  String?
}

model AIRequest {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  modelName   String
  data        String
  response    String?
  llmModel    String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  successful Boolean @default(false)
}

// Used to authenticate users from cli
model AuthorizationCode {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  personalAccessTokenId String?
  workspaceId           String?
  code                  String
}

model Company {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name       String
  domain     String?
  website    String?
  description String?
  logo       String?

  industry String?
  size     String?
  type     String?
  metadata Json?

  people      People[] // All people from this company
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String
}

model Conversation {
  id                  String                @id @default(uuid())
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deleted             DateTime?
  title               String?
  user                User                  @relation(fields: [userId], references: [id])
  userId              String
  workspace           Workspace?            @relation(fields: [workspaceId], references: [id])
  workspaceId         String?
  ConversationHistory ConversationHistory[]
}

model ConversationHistory {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deleted        DateTime?
  message        String
  userType       UserType
  context        Json?
  thoughts       Json?
  user           User?        @relation(fields: [userId], references: [id])
  userId         String?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
}

model Cycle {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name        String
  description String?
  number      Int

  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  startDate DateTime
  endDate   DateTime
  closedAt  DateTime?
  status    String

  history CycleHistory[]

  preferences Json @default("{}")

  issues Issue[]
}

model CycleHistory {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  userId  String?
  cycle   Cycle   @relation(fields: [cycleId], references: [id])
  cycleId String

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id])

  changeType CycleHistoryChangeType

  fromStateId  String?
  toStateId    String?
  fromEstimate Int?
  toEstimate   Int?
}

model Emoji {
  id        String     @id @default(uuid())
  name      String
  reactions Reaction[]

  @@unique([name])
}

model IntegrationAccount {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  integrationConfiguration Json
  // Unique Identifier for each connected app or personal account
  accountId                String?
  settings                 Json?
  isActive                 Boolean @default(true)
  personal                 Boolean @default(false)

  integratedBy            User                    @relation(references: [id], fields: [integratedById])
  integratedById          String
  integrationDefinition   IntegrationDefinitionV2 @relation(references: [id], fields: [integrationDefinitionId])
  integrationDefinitionId String
  workspace               Workspace               @relation(references: [id], fields: [workspaceId])
  workspaceId             String

  @@unique([accountId, integrationDefinitionId, workspaceId])
}

model IntegrationDefinitionV2 {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name         String     @unique
  slug         String
  description  String
  icon         String
  clientId     String
  clientSecret String
  config       Json?
  workspace    Workspace? @relation(references: [id], fields: [workspaceId])
  workspaceId  String?

  IntegrationAccount IntegrationAccount[]
}

model Invite {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  sentAt      DateTime
  expiresAt   DateTime
  emailId     String
  fullName    String
  workspaceId String
  status      InviteStatus
  teamIds     String[]
  role        Role

  @@unique([emailId, workspaceId])
}

model Issue {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  title             String
  number            Int
  description       String?
  priority          Int?
  dueDate           DateTime?
  sortOrder         Int?
  subIssueSortOrder Int?
  estimate          Int?
  sourceMetadata    Json?
  isBidirectional   Boolean?

  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  projectMilestone   ProjectMilestone? @relation(fields: [projectMilestoneId], references: [id])
  projectMilestoneId String?

  cycle   Cycle?  @relation(fields: [cycleId], references: [id])
  cycleId String?

  createdById String?
  updatedById String?

  subscriberIds String[]
  assigneeId    String?
  labelIds      String[]
  stateId       String
  parent        Issue?   @relation("Report", fields: [parentId], references: [id])
  parentId      String?
  subIssue      Issue[]  @relation("Report")
  attachments   String[]

  comments       IssueComment[]
  checklistItems ChecklistItem[]
  history        IssueHistory[]
  linkedIssue    LinkedIssue[]
  issueRelations IssueRelation[]
  cycleHistory   CycleHistory[]
  projectHistory ProjectHistory[]

  support Support?

  IssueSuggestion   IssueSuggestion? @relation(fields: [issueSuggestionId], references: [id])
  issueSuggestionId String?          @unique

  @@unique([teamId, number])
}

// One criterion on an issue's Definition of Done. Its own table (rather than a
// JSON column on Issue) so each item flows through logical replication like any
// other model: created, ticked, reordered, and soft-deleted independently, each
// change becoming its own sync action.
model ChecklistItem {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  body      String
  completed Boolean   @default(false)
  // Nullable so rows written before an explicit ordering existed fall back to
  // createdAt until the list is next reordered.
  sortOrder Int?

  completedAt   DateTime?
  completedById String?

  issue   Issue  @relation(fields: [issueId], references: [id])
  issueId String

  createdById String?
  updatedById String?

  @@index([issueId])
}

model IssueComment {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  body           String
  sourceMetadata Json?

  userId      String?
  updatedById String?

  reactions     Reaction[]
  reactionsData Json[]
  issue         Issue         @relation(fields: [issueId], references: [id])
  issueId       String
  parent        IssueComment? @relation("Report", fields: [parentId], references: [id])
  parentId      String?
  attachments   String[]

  replies       IssueComment[]  @relation("Report")
  linkedComment LinkedComment[]
}

model IssueHistory {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  userId         String?
  issue          Issue   @relation(fields: [issueId], references: [id])
  issueId        String
  sourceMetaData Json?

  addedLabelIds          String[]
  removedLabelIds        String[]
  fromPriority           Int?
  toPriority             Int?
  fromStateId            String?
  toStateId              String?
  fromEstimate           Int?
  toEstimate             Int?
  fromAssigneeId         String?
  toAssigneeId           String?
  fromParentId           String?
  toParentId             String?
  fromTeamId             String?
  toTeamId               String?
  fromProjectId          String?
  toProjectId            String?
  fromProjectMilestoneId String?
  toProjectMilestoneId   String?

  fromCycleId     String?
  toCycleId       String?
  relationChanges Json?
}

model IssueRelation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue          Issue             @relation(references: [id], fields: [issueId])
  issueId        String
  relatedIssueId String
  type           IssueRelationType
  metadata       Json?

  createdById String?

  deletedById String?
  deleted     DateTime?

  @@unique([issueId, relatedIssueId, type])
}

model IssueSuggestion {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  issueId             String   @unique
  suggestedLabelIds   String[]
  suggestedAssigneeId String?
  metadata            Json?
  issue               Issue?
}

model PersonalAccessToken {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name  String
  jwt   String
  token String

  user        User   @relation(fields: [userId], references: [id])
  userId      String
  type        String @default("user")
  workspaceId String

  @@unique([name, userId, token])
  /// Authenticating a request means finding the token by value, and the
  /// uniqueness constraint above cannot serve a lookup on `token` alone.
  @@index([token])
}

model Label {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name        String
  color       String
  description String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String
  team        Team?     @relation(fields: [teamId], references: [id])
  teamId      String?
  group       Label?    @relation("Group", fields: [groupId], references: [id])
  groupId     String?
  labels      Label[]   @relation("Group")

  @@unique([name, workspaceId])
}

model LinkedComment {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  url         String
  sourceId    String
  sourceData  Json?
  createdById String?

  comment   IssueComment @relation(fields: [commentId], references: [id])
  commentId String

  @@unique([url])
}

model LinkedIssue {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  url         String
  sourceId    String?
  sourceData  Json?
  sync        Boolean @default(true)
  createdById String?
  updatedById String?

  issue   Issue  @relation(fields: [issueId], references: [id])
  issueId String
}

model Notification {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  type           NotificationActionType
  userId         String
  issueId        String?
  actionData     Json?
  createdById    String?
  sourceMetadata Json?

  readAt       DateTime?
  snoozedUntil DateTime?

  workspaceId String
}

model People {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name  String
  email String
  phone String?

  metadata Json?

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  reportedIssues Support[]

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String
  @@unique([email, workspaceId])
}

/// A canonical document. The human half of the knowledge bank — a Confluence
/// page — and the thing an agent's asserted facts hang off.
///
/// The body is tiptap JSON exactly like `Issue.description`, so the editor, the
/// markdown converters and the search text extraction are all reused rather
/// than reinvented for documentation.
model Page {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  title String
  /// Tiptap JSON. The API speaks markdown on both sides of this column, so no
  /// caller ever has to parse editor JSON to read a page.
  description String?

  /// Pages nest, so a workspace's documentation is a tree rather than a list.
  parent   Page?   @relation("PageTree", fields: [parentId], references: [id])
  parentId String?
  children Page[]  @relation("PageTree")

  sortOrder Int?

  /// How strictly appends to this page are policed. One column, so a workspace
  /// need not pick a single strictness for every kind of knowledge it holds.
  entryPolicy PageEntryPolicy @default(CURATED)

  /// Shape only for now: sharing is workspace-only and nothing beyond
  /// workspace membership is enforced.
  visibility PageVisibility @default(WORKSPACE)

  entries PageEntry[]
  history PageHistory[]
  links   PageLink[]

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  createdById String?
  updatedById String?

  @@index([workspaceId])
  @@index([parentId])
}

/// One atomic asserted fact, appended to a page. This is what agents write:
/// short, markdown, never prose.
///
/// Agents append entries by default and touch page bodies only when asked.
/// Concurrent prose editing by many agents produces churn, editor merge
/// conflicts and no record of who claimed what; atomic appends are safe at any
/// rate and carry provenance for free.
model PageEntry {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  /// Markdown, short. One claim per row.
  content String

  /// Where the fact applies — a repo path glob, a team, a project. Null means
  /// it applies to the page as a whole.
  scope String?

  /// Retrieval serves only STANDING entries. Without that boundary the bank
  /// accumulates contradictions and stops being trusted: a wiki rots over
  /// years, a bank ten agent sessions a day write into rots in days.
  status PageEntryStatus @default(PROPOSED)

  /// Who asserted it. An `AGENT`-typed user is what makes this meaningful — an
  /// agent-written claim and a human-written one are identical as text.
  sourceUserId String?
  /// Opaque harness session id, so a claim can be traced back to the run.
  sourceSession String?
  /// The token the append arrived on. This is what the per-token budget counts,
  /// so one noisy harness cannot spend another's allowance.
  sourceTokenId String?

  /// A newer entry points at the one it replaces. Unique because two entries
  /// replacing the same fact is a contradiction, not a supersede.
  supersedes   PageEntry? @relation("PageEntrySupersede", fields: [supersedesId], references: [id])
  supersedesId String?    @unique
  supersededBy PageEntry? @relation("PageEntrySupersede")

  verifiedByUserId String?
  verifiedAt       DateTime?

  /// Written by the retrieval layer when this entry is actually served. Unused
  /// knowledge is by definition not load-bearing, so this is what the decay job
  /// reads to archive entries nobody ever asks for.
  retrievalCount Int       @default(0)
  lastServedAt   DateTime?

  page   Page   @relation(fields: [pageId], references: [id])
  pageId String

  @@index([pageId])
  @@index([status])
}

/// A question an agent asked that the bank could not answer.
///
/// The most valuable signal the system produces: it says which page to write
/// next, and it turns the bank from a record of what agents dumped into a
/// record of what agents needed.
///
/// Kept in postgres rather than in a typesense `nohits_queries` analytics rule,
/// which aggregates across the whole index with no workspace field — one
/// workspace's unanswered questions are not another's to read, and a query
/// string is often the most revealing thing about work in progress.
model PageKnowledgeGap {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Normalised query text, so "redis eviction" and "Redis  Eviction" are one
  /// gap rather than two.
  query String
  /// How many times it has been asked. Demand, not just absence.
  count Int @default(1)

  workspaceId String

  @@unique([workspaceId, query])
  @@index([workspaceId])
}

/// Who changed what on a page, mirroring IssueHistory.
model PageHistory {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  userId String?

  page   Page   @relation(fields: [pageId], references: [id])
  pageId String

  /// The change as a small JSON patch: `{ "title": { "from": …, "to": … } }`.
  changes Json?

  /// The body as it stood *before* this change, when this change touched it.
  ///
  /// Agents may rewrite a page wholesale to keep it current, which is the point
  /// — but a rewrite that cannot be seen or undone is not an edit, it is a
  /// replacement. The patch above recorded only that the body changed, so there
  /// was nothing to diff against and nothing to go back to. Kept as the same
  /// tiptap JSON `Page.description` holds, so a revert is a straight write.
  previousBody String?

  @@index([pageId])
}

model Project {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name        String
  description String?
  status      String?
  startDate   String?
  endDate     String?
  leadUserId  String?
  teams       String[]

  milestones ProjectMilestone[]
  issues     Issue[]
  history    ProjectHistory[]

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  @@unique([name, workspaceId])
}

model ProjectHistory {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  userId    String?
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  issueId   String
  issue     Issue   @relation(fields: [issueId], references: [id])

  changeType ProjectHistoryChangeType

  fromStateId  String?
  toStateId    String?
  fromEstimate Int?
  toEstimate   Int?
}

model ProjectMilestone {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name        String
  description String?
  endDate     String?

  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  issues Issue[]

  @@unique([name, projectId])
}

model Prompt {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name        String
  prompt      String
  model       LLMModels @default(GPT35TURBO)
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  @@unique([name, workspaceId])
}

model Reaction {
  id        String    @id @default(uuid())
  reactedAt DateTime  @default(now())
  deleted   DateTime?

  userId String

  comment   IssueComment @relation(fields: [commentId], references: [id])
  commentId String
  emoji     Emoji        @relation(fields: [emojiId], references: [id])
  emojiId   String

  @@unique([emojiId, commentId, userId])
}

model Support {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  reportedBy   People? @relation(fields: [reportedById], references: [id])
  reportedById String?

  slaStatus       String?

  actualFrtAt     DateTime?
  firstResponseAt DateTime?
  nextResponseAt  DateTime?
  resolvedAt      DateTime?
  slaDueBy        DateTime?

  metadata Json?

  issue   Issue  @relation(fields: [issueId], references: [id])
  issueId String @unique
}

model SyncAction {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  modelName  ModelName
  modelId    String
  action     ActionType
  sequenceId BigInt

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  @@unique([modelId, action])
}

model Team {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name       String
  identifier String
  icon       String?

  currentCycle Int?

  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  workspaceId String
  issue       Issue[]
  cycles      Cycle[]
  label       Label[]
  template    Template[]
  workflow    Workflow[]
  preferences Json       @default("{}")
  View        View[]

  @@unique([name, identifier, workspaceId])
}

model Template {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name         String
  category     TemplateCategory
  templateData Json

  createdBy   User      @relation(fields: [createdById], references: [id])
  createdById String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String
  team        Team?     @relation(fields: [teamId], references: [id])
  teamId      String?
}

model User {
  // Its own key. This used to be whatever id SuperTokens minted, which made
  // identity and credentials the same column and meant one person could hold
  // exactly one credential: a passkey and a login code for the same address
  // are two SuperTokens users, and only one of them could be this value.
  id String @id @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String   @unique

  /// What this account *is*, as opposed to what it may do in a given workspace.
  /// Role lives on the membership and is per workspace; an agent is an agent
  /// everywhere, and the UI badges it as non-human off this.
  type UserType @default(User)

  fullname                String?
  username                String
  initialSetupComplete    Boolean @default(false)
  anonymousDataCollection Boolean @default(false)

  image String?

  authIdentities      AuthIdentity[]
  usersOnWorkspaces   UsersOnWorkspaces[]
  template            Template[]
  integrationAccount  IntegrationAccount[]
  attachment          Attachment[]
  personalAccessToken PersonalAccessToken[]
  Conversation        Conversation[]
  ConversationHistory ConversationHistory[]
}

/// One way in to an account: a login code, a passkey, whatever comes later.
/// SuperTokens owns the credential and issues a recipe user id per method, so
/// somebody with both a passkey and a login code has two rows here pointing at
/// one User. This is the table account linking would have been paying for.
model AuthIdentity {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// SuperTokens recipe id: `passwordless`, `webauthn`.
  provider String

  /// The recipe user id SuperTokens issued. Sessions arrive carrying this, and
  /// minting one for a personal access token needs it back.
  supertokensUserId String @unique

  @@unique([userId, provider])
  @@index([userId])
}

model UsersOnWorkspaces {
