model IssueSuggestion {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  issueId             String   @unique
  suggestedLabelIds   String[]
  suggestedAssigneeId String?
  /// The modules that the LLM proposes for this issue. A suggestion never
  /// reaches Issue.moduleIds on its own. A person accepts it first.
  suggestedModuleIds  String[]
  metadata            Json?
  issue               Issue?
}

model PersonalAccessToken {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name  String
  jwt   String
  token String

  /// When this token last authenticated a request.
  ///
  /// Written on a throttle rather than on every request: the value is read by
  /// people deciding whether a credential is still in use, and that question is
  /// not asked to the minute. Null means it has never been used — which is the
  /// signal that an agent account is a leftover rather than something live.
  lastUsedAt DateTime?

  user        User   @relation(fields: [userId], references: [id])
  userId      String
  type        String @default("user")
  workspaceId String

  @@unique([name, userId, token])
  /// Authenticating a request means finding the token by value, and the
  /// uniqueness constraint above cannot serve a lookup on `token` alone.
  @@index([token])
}

