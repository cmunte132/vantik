datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // previewFeatures = []
}

model Action {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name         String
  description  String?
  slug         String
  integrations String[]

  status  ActionStatus
  version String
  url     String?

  // To define if the action is deployed in personal account
  isPersonal Boolean @default(false)

  // We store the config of the action
  config Json

  // This is used to store inputs or some data needed for the action 
  data Json?

  workspace    Workspace?     @relation(fields: [workspaceId], references: [id])
  workspaceId  String?
  actionEntity ActionEntity[]

  createdById    String
  actionSchedule ActionSchedule[]
}

model ActionEntity {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  type   String
  entity String

  action   Action @relation(fields: [actionId], references: [id])
  actionId String

  @@unique([type, entity, actionId])
}

model ActionEvent {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  eventType String
  modelName String // Issue
  modelId   String // Issue ID
  eventData Json? // Update data change

  sequenceId BigInt

  processed    Boolean   @default(false)
  processedAt  DateTime?
  processedIds String[]

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String
}

model ActionSchedule {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  cron       String?
  scheduleId String?
  status     ActionScheduleStatus
  timezone   String?

  scheduledById String
  action        Action @relation(fields: [actionId], references: [id])
  actionId      String

  @@unique([actionId, cron, timezone])
}

/// One agent's attempt at one issue.
///
/// The unit of work the whole Autonomous agents project turns on. Execution
/// backends — a runner on someone's laptop, a hosted sandbox, a third-party
/// coding agent — are all just writers against this record; none of them owns
/// the lifecycle, which is why cancelling from the webapp works the same way
/// whichever one is running.
///
/// A retry is a new row, not a mutated one. An attempt that lost its lease
/// three quarters of the way through is evidence, and evidence you overwrite
/// on retry is evidence you do not have when someone asks why the third
/// attempt also failed.
model AgentRun {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  issue   Issue  @relation(fields: [issueId], references: [id])
  issueId String

  /// The AGENT user the work is attributed to. Comments and commits carry this
  /// identity, so a reader can tell which agent produced what.
  agentUserId String
  /// The member who delegated. Never derived from issue content: if anything
  /// the agent reads could start a run, prompt injection gets an execution
  /// primitive for free.
  createdById String?

  /// Registry key for the backend — `byo`, `hosted`, later `github`. A string
  /// rather than an enum because adapters are meant to arrive without a
  /// migration.
  executor String
  status   AgentRunStatus @default(QUEUED)

  /// 1 for the first try. A lease that expires re-queues the work as a fresh
  /// row with attempt + 1, up to a cap.
  attempt Int @default(1)
  /// The run this one retries, so a chain of attempts is walkable in both
  /// directions without scanning by issue.
  previousRun   AgentRun?  @relation("AgentRunAttempts", fields: [previousRunId], references: [id])
  previousRunId String?    @unique
  nextRun       AgentRun?  @relation("AgentRunAttempts")

  /// Held by whoever claimed the run; renewed by heartbeat. Past it, the run is
  /// expired by the sweeper regardless of what the runner believes.
  leaseExpiresAt DateTime?
  claimedAt      DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?

  /// Prose for a human, written by the server from the executor's report — the
  /// executor never writes the comment itself.
  summary String?
  /// The operator-facing message behind a terminal failure.
  error String?
  /// Typed, so failures are countable. A free-text error field answers "what
  /// happened here" and never "how often does setup break".
  failure AgentRunFailure?

  /// Branch, PR url, linked issue id, token and cost counters.
  result Json?
  /// Repo, base branch, harness command, verification commands, limits.
  config Json?
  /// What the agent was handed, snapshotted at dispatch. Kept so a run stays
  /// reproducible after the issue it came from has been edited.
  contextPack Json?

  // Reproducibility and comparison. Present from the first migration on
  // purpose: added later, every run recorded before the migration is a
  // permanent hole in the population, and no two runs from either side of it
  // are comparable.

  /// Pinned harness build, e.g. `pi@0.82.1`.
  harnessVersion String?
  /// The model the harness actually ran, as the provider names it.
  modelId String?
  /// Hash over the effective config — harness, limits, phase flags. Two runs
  /// with the same hash were asked the same question.
  configHash String?
  /// How many implement/score cycles ran. 0 until the ENG-62 loop is enabled.
  iterationCount Int @default(0)
  /// Milliseconds per phase: `{ setup, specify, implement, score, review }`.
  /// One blob rather than a column each, because the phase set is exactly what
  /// ENG-62 is expected to change.
  phaseTimings Json?
  /// The commit the patch is computed against. Authoritative: the diff is
  /// `git diff` versus this, never a model-emitted patch.
  baseCommit String?

  events     AgentRunEvent[]
  iterations AgentRunIteration[]

  @@index([workspaceId, status])
  @@index([issueId])
  @@index([agentUserId])
  @@index([status, leaseExpiresAt])
}

/// An append-only progress line on a run.
///
/// So the UI and the CLI can tail a run without the executor holding a socket
/// open — a runner in someone's CI cannot keep one, and a run that only exists
/// while a connection does is a run nobody can walk away from.
model AgentRunEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  /// When the executor says it happened, which is not when we stored it.
  at      DateTime          @default(now())
  level   AgentRunEventLevel @default(INFO)
  message String
  /// Phase this line belongs to, when the harness knows: only it can see the
  /// boundaries.
  phase String?
  data  Json?

  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  @@index([runId, at])
}

/// One pass of the ENG-62 implement/score loop.
///
/// Carried from the first migration even though the loop ships disabled: the
/// alternative is discovering later that every run predating it has no
/// per-iteration record, which is the same comparability hole the fields above
/// exist to avoid.
model AgentRunIteration {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String
  /// 1-based.
  index Int

  /// Pass rate over the suite the implementer could see.
  validationPassRate Float?
  /// Pass rate over the suite it never saw.
  heldOutPassRate Float?
  /// validation − held-out. The reward-hacking metric: numeric, per-iteration,
  /// no model asked for an opinion. Widening while validation climbs is the
  /// signature of optimising the proxy, and aborts the loop.
  delta Float?

  /// Whether the repo's own verification commands passed this pass.
  verificationPassed Boolean?
  /// Review findings, each carrying a `file:line` or a failing command.
  /// Findings without evidence are discarded before they get here.
  findings Json?
  /// Hash of the patch this iteration produced, for detecting the oscillation
  /// case where two passes change nothing.
  diffHash String?
  phaseTimings Json?

  @@unique([runId, index])
  @@index([runId])
}

/// A secret a workspace hands Vantik so hosted runs can work on its behalf.
///
/// Write-only over the API: creation and rotation return a masked handle and
/// no endpoint reads one back. The decisive property is not the encryption
/// though — it is that the git token never enters the sandbox at all. A
/// sandbox stops an agent rooting the host; only keeping the credential
/// outside it stops a prompt-injected agent exfiltrating the token it was
/// handed.
model WorkspaceCredential {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  kind WorkspaceCredentialKind

  /// Which model provider a MODEL_API_KEY belongs to — `anthropic`, `openai`,
  /// `openrouter` and so on, matching a row in the MODEL_PROVIDERS table in
  /// the types package. A workspace holds one key per provider.
  ///
  /// This is what tells the executor which environment variable to hand the
  /// key to the harness under. There is no generic one: Pi reads
  /// ANTHROPIC_API_KEY, OPENAI_API_KEY and the rest by name, so a key with no
  /// provider is a key the harness cannot use.
  ///
  /// Empty for a GIT_TOKEN, which has no provider. Empty rather than null so
  /// the unique index below actually constrains it — Postgres treats nulls as
  /// distinct, so a nullable column here would allow unlimited duplicates.
  provider String @default("")

  /// AES-256-GCM, under a key derived from the server secret. Never returned.
  ciphertext String
  nonce      String
  tag        String

  /// The last few characters, so a human can tell which key is which without
  /// the API ever handing back the secret.
  hint String

  /// The account's own endpoint, for a provider that has one per customer.
  /// Most have a single fixed host and leave this empty.
  baseUrl String?

  /// What the key could reach when it was last checked, and when. Cached so
  /// the settings screen can name the models a key offers without calling the
  /// provider on every render.
  models        Json?
  modelsCheckedAt DateTime?

  createdById String?
  rotatedAt   DateTime?

  @@unique([workspaceId, kind, provider])
  @@index([workspaceId])
}

model Attachment {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  fileName       String?
  originalName   String
  fileType       String
  fileExt        String
  size           Int
  url            String?
  status         AttachmentStatus
  sourceMetadata Json?

  uploadedBy   User?      @relation(fields: [uploadedById], references: [id])
  uploadedById String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id])
  workspaceId  String?
}

model AIRequest {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  modelName   String
  data        String
  response    String?
  llmModel    String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  successful Boolean @default(false)
}

// Used to authenticate users from cli
model AuthorizationCode {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  personalAccessTokenId String?
  workspaceId           String?
  code                  String
}

model Company {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name        String
  domain      String?
  website     String?
  description String?
  logo        String?

  industry String?
  size     String?
  type     String?
  metadata Json?

  people      People[] // All people from this company
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String
}

model Conversation {
  id                  String                @id @default(uuid())
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deleted             DateTime?
  title               String?
  user                User                  @relation(fields: [userId], references: [id])
  userId              String
  workspace           Workspace?            @relation(fields: [workspaceId], references: [id])
  workspaceId         String?
  ConversationHistory ConversationHistory[]
}

model ConversationHistory {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deleted        DateTime?
  message        String
  userType       UserType
  context        Json?
  thoughts       Json?
  user           User?        @relation(fields: [userId], references: [id])
  userId         String?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
}

model Cycle {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name        String
  description String?
  number      Int

  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  startDate DateTime
  endDate   DateTime
  closedAt  DateTime?
  status    String

  history CycleHistory[]

  preferences Json @default("{}")

  issues Issue[]
}

model CycleHistory {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  userId  String?
  cycle   Cycle   @relation(fields: [cycleId], references: [id])
  cycleId String

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id])

  changeType CycleHistoryChangeType

  fromStateId  String?
  toStateId    String?
  fromEstimate Int?
  toEstimate   Int?
}

model Emoji {
  id        String     @id @default(uuid())
  name      String
  reactions Reaction[]

  @@unique([name])
}

model IntegrationAccount {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  integrationConfiguration Json
  // Unique Identifier for each connected app or personal account
  accountId                String?
  settings                 Json?
  isActive                 Boolean @default(true)
  personal                 Boolean @default(false)

  integratedBy            User                    @relation(references: [id], fields: [integratedById])
  integratedById          String
  integrationDefinition   IntegrationDefinitionV2 @relation(references: [id], fields: [integrationDefinitionId])
  integrationDefinitionId String
  workspace               Workspace               @relation(references: [id], fields: [workspaceId])
  workspaceId             String

  @@unique([accountId, integrationDefinitionId, workspaceId])
}

model IntegrationDefinitionV2 {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name         String     @unique
  slug         String
  description  String
  icon         String
  clientId     String
  clientSecret String
  config       Json?
  workspace    Workspace? @relation(references: [id], fields: [workspaceId])
  workspaceId  String?

  IntegrationAccount IntegrationAccount[]
}

model Invite {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  sentAt      DateTime
  expiresAt   DateTime
  emailId     String
  fullName    String
  workspaceId String
  status      InviteStatus
  teamIds     String[]
  role        Role

  @@unique([emailId, workspaceId])
}

model Issue {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  title             String
  number            Int
  description       String?
  priority          Int?
  dueDate           DateTime?
  sortOrder         Int?
  subIssueSortOrder Int?
  estimate          Int?
  sourceMetadata    Json?
  isBidirectional   Boolean?

  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  projectMilestone   ProjectMilestone? @relation(fields: [projectMilestoneId], references: [id])
  projectMilestoneId String?

  cycle   Cycle?  @relation(fields: [cycleId], references: [id])
  cycleId String?

  /// The modules that this issue changes. The list can be empty, and an issue
  /// can touch more than one Module. Three things write this list: a person, a
  /// pull request, and nothing else. The LLM writes to
  /// IssueSuggestion.suggestedModuleIds instead, and a person accepts the
  /// suggestion before it arrives here.
  moduleIds String[]

  /// What the issue makes the software do. One Capability, or none.
  capability   Capability? @relation(fields: [capabilityId], references: [id])
  capabilityId String?

  createdById String?
  updatedById String?

  subscriberIds String[]
  assigneeId    String?
  labelIds      String[]
  stateId       String
  parent        Issue?   @relation("Report", fields: [parentId], references: [id])
  parentId      String?
  subIssue      Issue[]  @relation("Report")
  attachments   String[]

  comments       IssueComment[]
  checklistItems ChecklistItem[]
  agentRuns      AgentRun[]
  history        IssueHistory[]
  linkedIssue    LinkedIssue[]
  issueRelations IssueRelation[]
  cycleHistory   CycleHistory[]
  projectHistory ProjectHistory[]

  support Support?

  IssueSuggestion   IssueSuggestion? @relation(fields: [issueSuggestionId], references: [id])
  issueSuggestionId String?          @unique

  @@unique([teamId, number])
}

// One criterion on an issue's Definition of Done. Its own table (rather than a
// JSON column on Issue) so each item flows through logical replication like any
// other model: created, ticked, reordered, and soft-deleted independently, each
// change becoming its own sync action.
model ChecklistItem {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  body      String
  completed Boolean @default(false)
  // Nullable so rows written before an explicit ordering existed fall back to
  // createdAt until the list is next reordered.
  sortOrder Int?

  completedAt   DateTime?
  completedById String?

  issue   Issue  @relation(fields: [issueId], references: [id])
  issueId String

  createdById String?
  updatedById String?

  @@index([issueId])
}

model IssueComment {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  body           String
  sourceMetadata Json?

  userId      String?
  updatedById String?

  reactions     Reaction[]
  reactionsData Json[]
  issue         Issue         @relation(fields: [issueId], references: [id])
  issueId       String
