enum Preference {
  ISSUE_ESTIMATES
  PRIORITIES
}

enum Role {
  ADMIN
  USER
  BOT
  AGENT
}

enum Status {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ActionStatus {
  DEPLOYING
  ERRORED
  INSTALLED
  NEEDS_CONFIGURATION
  ACTIVE
  SUSPENDED
}

enum ActionScheduleStatus {
  ACTIVE
  IN_ACTIVE
  DELETED
}

/// Where a run is in its life.
///
/// `QUEUED → CLAIMED → RUNNING → terminal`, enforced server-side against a
/// transition table rather than by whoever happens to be writing. A runner that
/// crashed and came back believing it still owns a run will try to report on
/// one the sweeper already expired; the table is what refuses it.
enum AgentRunStatus {
  /// Waiting for a backend to take it.
  QUEUED
  /// A backend has it and holds a lease, but has not started work.
  CLAIMED
  /// The harness is running.
  RUNNING

  // Terminal. Nothing leaves these; a retry opens a new row.

  /// Work produced and reported — a branch, usually a PR.
  SUCCEEDED
  /// Reached a terminal failure; see `failure` for which.
  FAILED
  /// Stopped deliberately, by a person or by reassignment.
  CANCELED
  /// The lease lapsed. Distinct from FAILED because nothing is known about
  /// what the runner was doing, and it is the one terminal state that is
  /// automatically retryable.
  EXPIRED
  /// Finished, but a human has to look: the issue was not test-specifiable, or
  /// the ENG-62 loop aborted on a widening Δ. Not a failure, and reporting it
  /// as one would train people to ignore the category that most needs them.
  NEEDS_REVIEW
}

/// Why a run ended badly, as a closed set.
///
/// Every one of these is a different thing for the user to go and fix, which
/// is the test for whether a category earns a place here.
enum AgentRunFailure {
  /// Clone, dependency install or service startup failed. The most common one
  /// in practice: "the agent failed" is usually "the agent could not run
  /// anything".
  ENVIRONMENT_SETUP_FAILED
  /// The harness process died or broke protocol.
  HARNESS_CRASHED
  /// Wall-clock, token or iteration budget spent.
  BUDGET_EXHAUSTED
  /// The harness finished and changed nothing.
  NO_DIFF_PRODUCED
  /// The repo's own tests, typecheck or lint failed and the loop could not
  /// recover.
  VERIFICATION_FAILED
  /// The git host refused the push — protected branch, stale base, no rights.
  PUSH_REJECTED
  /// The branch went up but opening the pull request failed.
  PR_CREATION_FAILED
  /// The sandbox blocked a network call the run needed. Also the clearest
  /// prompt-injection signal available, so it is never folded into a generic
  /// failure.
  EGRESS_DENIED
  /// The lease lapsed while work was in flight.
  LEASE_LOST
  /// No executable test could be derived from the Definition of Done — a
  /// refactor, a docs change, a dependency bump. Routes to human review.
  NOT_TEST_SPECIFIABLE
  /// Δ widened while the visible pass rate climbed: the run was optimising the
  /// tests it could see rather than the spec. Routes to human review.
  REWARD_HACK_SUSPECTED
}

/// What kind of secret a workspace credential holds.
enum WorkspaceCredentialKind {
  /// Used by the harness inside the sandbox — it has to reach the model.
  MODEL_API_KEY
  /// Used by the host to push and open pull requests on the sandbox's
  /// request. Never injected into the guest.
  GIT_TOKEN
}

enum AgentRunEventLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// The label on a sync action. It names the table that a record came from.
///
/// A value that the schema does not declare stops every read of this table,
/// and the whole sync log then fails, and not only the rows of that one model.
/// So a new model's value is added to this enum before any row can carry it.
enum ModelName {
  Action
  ActionEntity
  AgentRun
  AgentRunEvent
  AgentRunIteration
  Attachment
  AIRequest
  Capability
  ChecklistItem
  Cycle
  Company
  Conversation
  ConversationHistory
  Emoji
  IntegrationAccount
  IntegrationDefinition
  IntegrationDefinitionV2
  Invite
  Issue
  IssueComment
  IssueHistory
  IssueRelation
  IssueSuggestion
  Label
  LinkedComment
  LinkedIssue
  Module
  Notification
  Page
  PageEntry
  PageHistory
  People
  Product
  Project
  ProjectMilestone
  Prompt
  Reaction
  Support
  SyncAction
  Team
  Template
  TriggerProject
  User
  UsersOnWorkspaces
  View
  Workflow
  Workspace
  WorkspaceTriggerProject
}

/// What a page has been linked to.
///
/// Polymorphic rather than one nullable column per kind, because the set of
/// things worth relating a page to grows — a cycle, a label, a customer — and
/// each new one would otherwise be a migration plus a branch in every query
/// that walks the graph.
enum PageLinkType {
  TEAM
  PROJECT
  ISSUE
  /// Page to page. Bodies can already mention each other in prose, but prose is
  /// not traversable and says nothing in the other direction.
  PAGE
}

/// An edge between a page and something else in the workspace.
///
/// Nesting gives a page exactly one parent, which is the wrong shape for "this
/// runbook belongs to the Payments project and the Platform team". This is the
/// shape that answers that, and it is what lets an agent holding an issue find
/// the documentation for it instead of guessing search terms.
model PageLink {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  page   Page   @relation(fields: [pageId], references: [id])
  pageId String

  entityType PageLinkType
  /// Deliberately not a foreign key: one column cannot reference four tables.
  /// The cost is that a dangling edge is possible, so reads resolve targets and
  /// drop the ones that no longer exist rather than trusting the row.
  entityId   String

  createdById String?

  /// The same edge twice is not two facts about the graph.
  @@unique([pageId, entityType, entityId])
  @@index([pageId])
  /// The reverse direction, and the reason this is a graph rather than a list:
  /// "what pages relate to this issue" has to be a lookup, not a scan of every
  /// issue body in the workspace.
  @@index([entityType, entityId])
}

/// How strictly a page polices appended entries.
///
/// The failure mode this exists for is not one badly-behaved agent; it is ten
/// well-behaved ones each appending the same six facts, because rediscovering
/// those facts is exactly what a memory bank exists to prevent. Asking agents to
/// be tidy in a tool description is the weakest control available — it fails
/// precisely when a cheaper or unfamiliar model is pointed at the endpoint,
/// which is the cross-harness case this feature exists to serve.
enum PageEntryPolicy {
  /// Append freely. Scratch pages, where volume does not matter.
  OPEN
  /// Dedup and the per-token budget are enforced. The default.
  CURATED
  /// Human-only. Agents read the page but cannot append to it.
  LOCKED
}

enum PageEntryStatus {
  /// Awaiting triage. An inbox, never served.
  PROPOSED
  /// True, too granular for prose, and worth retrieving. The only status
  /// retrieval serves.
  STANDING
  /// Folded into the page body. Must stop being served separately, or the same
  /// fact comes back twice.
  CONSOLIDATED
  /// Replaced by a newer entry. Kept for audit, never served.
  SUPERSEDED
  /// Contradicts the body or another entry. Withheld until resolved.
  DISPUTED
  /// Aged out — either never triaged or never read.
  ARCHIVED
}

enum PageVisibility {
  WORKSPACE
}

enum ActionType {
  I
  U
  D
}

enum WorkflowCategory {
  TRIAGE
  BACKLOG
  UNSTARTED
  STARTED
  COMPLETED
  CANCELED
}

enum TemplateCategory {
  ISSUE
  PROJECT
  DOCUMENT
}

enum IssueRelationType {
  BLOCKS
  BLOCKED
  RELATED
  DUPLICATE
  DUPLICATE_OF
  SIMILAR
}

enum NotificationActionType {
  IssueAssigned
  IssueUnAssigned
  IssueStatusChanged
  IssuePriorityChanged
  IssueNewComment
  IssueBlocks
}

enum AttachmentStatus {
  Pending
  Failed
  Uploaded
  Deleted
  External
