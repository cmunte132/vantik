/// A canonical document. The human half of the knowledge bank — a Confluence
/// page — and the thing an agent's asserted facts hang off.
///
/// The body is tiptap JSON exactly like `Issue.description`, so the editor, the
/// markdown converters and the search text extraction are all reused rather
/// than reinvented for documentation.
model Page {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  title       String
  /// Tiptap JSON. The API speaks markdown on both sides of this column, so no
  /// caller ever has to parse editor JSON to read a page.
  description String?

  /// Pages nest, so a workspace's documentation is a tree rather than a list.
  parent   Page?   @relation("PageTree", fields: [parentId], references: [id])
  parentId String?
  children Page[]  @relation("PageTree")

  sortOrder Int?

  /// How strictly appends to this page are policed. One column, so a workspace
  /// need not pick a single strictness for every kind of knowledge it holds.
  entryPolicy PageEntryPolicy @default(CURATED)

  /// Shape only for now: sharing is workspace-only and nothing beyond
  /// workspace membership is enforced.
  visibility PageVisibility @default(WORKSPACE)

  entries PageEntry[]
  history PageHistory[]
  links   PageLink[]

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  createdById String?
  updatedById String?

  @@index([workspaceId])
  @@index([parentId])
}

/// One atomic asserted fact, appended to a page. This is what agents write:
/// short, markdown, never prose.
///
/// Agents append entries by default and touch page bodies only when asked.
/// Concurrent prose editing by many agents produces churn, editor merge
/// conflicts and no record of who claimed what; atomic appends are safe at any
/// rate and carry provenance for free.
model PageEntry {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  /// Markdown, short. One claim per row.
  content String

  /// Where the fact applies — a repo path glob, a team, a project. Null means
  /// it applies to the page as a whole.
  scope String?

  /// The modules the scope falls in, resolved against `ModuleRepo.pathPrefixes`
  /// when the scope is written and again whenever a module's repositories
  /// change. Stored rather than computed on read because retrieval filters and
  /// boosts on it inside the search index, which cannot run the resolution.
  moduleIds String[] @default([])

  /// What sort of knowledge this is. The bank's guidance already asks agents
  /// for decisions, gotchas and conventions; recording which one an entry is
  /// lets a reader ask for just the conventions of a module.
  kind PageEntryKind @default(FACT)

  /// Retrieval serves only STANDING entries. Without that boundary the bank
  /// accumulates contradictions and stops being trusted: a wiki rots over
  /// years, a bank ten agent sessions a day write into rots in days.
  status PageEntryStatus @default(PROPOSED)

  /// Who asserted it. An `AGENT`-typed user is what makes this meaningful — an
  /// agent-written claim and a human-written one are identical as text.
  sourceUserId  String?
  /// Opaque harness session id, so a claim can be traced back to the run.
  sourceSession String?
  /// The token the append arrived on. This is what the per-token budget counts,
  /// so one noisy harness cannot spend another's allowance.
  sourceTokenId String?

  /// A newer entry points at the one it replaces. Unique because two entries
  /// replacing the same fact is a contradiction, not a supersede.
  supersedes   PageEntry? @relation("PageEntrySupersede", fields: [supersedesId], references: [id])
  supersedesId String?    @unique
  supersededBy PageEntry? @relation("PageEntrySupersede")

  verifiedByUserId String?
  verifiedAt       DateTime?

  /// Written by the retrieval layer when this entry is actually served. Unused
  /// knowledge is by definition not load-bearing, so this is what the decay job
  /// reads to archive entries nobody ever asks for.
  retrievalCount Int       @default(0)
  lastServedAt   DateTime?

  /// Outcome signals from the runs this entry was served to, weighted: a full
  /// signal counts 1 and a weak one (a pull request closed without merging)
  /// counts half. Each is explained by a PageEntrySignal row. A harmful signal
  /// has the entry's citations checked again; neither archives anything.
  helpfulCount Float @default(0)
  harmfulCount Float @default(0)

  /// sha256 of the content in the form duplicates are compared in (case and
  /// runs of whitespace folded; see `normaliseContent`). Triage finds an exact
  /// repeat by it among the entries of the same modules, so it is stored and
  /// indexed rather than recomputed over every candidate.
  contentHash String?

  /// How many later entries said exactly this. A repeat corroborates the
  /// entry it repeats rather than standing beside it, and each one is kept as
  /// a DUPLICATE relation from the repeat, which records who said it and when.
  corroborationCount Int @default(0)

  page   Page   @relation(fields: [pageId], references: [id])
  pageId String

  /// What the claim rests on: code at a commit, or where it was decided.
  citations PageEntryCitation[]
  uses      PageEntryUse[]
  signals   PageEntrySignal[]

  triageDecisions KnowledgeTriageDecision[]
  relationsFrom   PageEntryRelation[]       @relation("PageEntryRelationFrom")
  relationsTo     PageEntryRelation[]       @relation("PageEntryRelationTo")
  maintenance     PageEntryMaintenance[]
  /// The reviewer findings this entry was proposed from, for a candidate
  /// convention.
  findings        KnowledgeFinding[]

  @@index([pageId])
  @@index([status])
  @@index([contentHash])
}

/// One piece of evidence for an entry, checked by the server.
///
/// A claim about code is only as good as the code still saying it, and a model
/// asked whether its own claim holds is the least reliable judge there is. So
/// a code citation records the lines at a commit, as the server read them, and
/// each check compares that text with the file as it is now. A decision cites
/// the issue, pull request, comment or run where it was made, and is checked
/// for existence in the workspace.
model PageEntryCitation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entry   PageEntry @relation(fields: [entryId], references: [id])
  entryId String

  kind PageEntryCitationKind

  // CODE
  moduleRepo   ModuleRepo? @relation(fields: [moduleRepoId], references: [id])
  moduleRepoId String?
  /// Relative to the repository root.
  path         String?
  /// The commit the lines were cited at.
  commitSha    String?
  /// The cited lines at the last check. A MOVED check updates them.
  startLine    Int?
  endLine      Int?
  /// The cited lines as the server read them, whitespace-normalised, so a
  /// re-check can tell a snippet that moved from one that changed. Never text
  /// the writer supplied.
  snippet      String?
  snippetHash  String?

  // ISSUE, PULL_REQUEST, COMMENT, RUN
  /// The issue, linked pull request, comment or run, by id.
  targetId    String?
  /// What a reader recognises it by: an issue key or a pull request URL.
  targetLabel String?

  /// A quote the writer gave that could not be checked because the source was
  /// unreachable at write. Compared with the lines when they are first read,
  /// then cleared; never served, and never the snippet.
  pendingQuote String?

  // The last check
  checkedAt   DateTime?
  checkedSha  String?
  checkResult PageEntryCitationCheck?

  /// For a CHANGED check only: whether the current code still supports the
  /// claim, as a model other than the writer's judged it, and which model.
  judgment    PageEntryCitationJudgment?
  judgeModel  String?
  judgeLines  String?
  judgeReason String?
  /// The entry's `contentHash` when the judge read it. A person may reword
  /// the entry afterwards, and a judgment of the old words says nothing
  /// about the new ones, so the gardener never acts on it for them.
  judgedContentHash String?

  @@index([entryId])
  @@index([moduleRepoId, path])
  @@index([checkResult])
}

/// One entry served to one reader, once.
///
/// `retrievalCount` says how often an entry is served; this says to whom and
/// for what. A run's outcome can only be attributed to the knowledge it was
/// given if what it was given is written down.
model PageEntryUse {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  entry   PageEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String

  workspaceId String

  /// The run the entry was packed for, when it was served to one.
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  agentRunId String?
  /// The harness session that asked, when it said which.
  sessionId  String?
  /// The token the request came in on. Null for a browser session or a run.
  tokenId    String?
  /// Who asked. Null for a run, which is the agent the run belongs to.
  userId     String?

  via PageEntryUseVia

  @@index([entryId, createdAt])
  @@index([agentRunId])
  @@index([workspaceId, createdAt])
}

/// One outcome attributed to one entry: why its helpful or harmful count moved.
///
/// One row per entry, run and source, so an outcome reported twice (a webhook
/// delivered again) moves a count once, and a later outcome from the same
/// source (a pull request reopened and merged) replaces the earlier one, the
/// counts moving by the difference.
model PageEntrySignal {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entry   PageEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String

  agentRun   AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  agentRunId String

  source PageEntrySignalSource
  kind   PageEntrySignalKind
  /// 1 for a full signal, 0.5 for a weak one.
  weight Float
  /// What pointed at the entry, for a harmful signal: the finding's
  /// `file:line`, or the failing command and the path its output named.
  evidence String?

  @@unique([entryId, agentRunId, source])
  @@index([agentRunId])
}

/// What triage decided about a new entry, and everything it decided on.
///
/// The audit trail of the automation, and what phase 5 measures it by. It is
/// written in shadow mode too, where nothing is acted on, so the decisions can
/// be compared with what people decided before automation is switched on. The
/// inputs are kept whole, with a digest to tell two decisions over the same
/// inputs apart from two over different ones; the models' answers are kept as
/// they came back, including ones that could not be read.
model KnowledgeTriageDecision {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  entry   PageEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String

  workspaceId String

  decision KnowledgeTriageDecisionType
  /// Why it escalated, every reason that applied. Empty for any other decision.
  reasons  KnowledgeEscalationReason[] @default([])
  /// The policy a REJECT broke, kept when a backed-off REJECT escalated.
  policy   KnowledgeTriagePolicy?
  /// SHADOW records and leaves the entry as it is; ON acts on the decision.
  mode     KnowledgeTriageMode
  /// Whether the decision changed anything: always false in shadow mode, and
  /// false for an escalation, which waits for a person.
  applied  Boolean                     @default(false)

  /// The entry an exact or near duplicate corroborated.
  corroboratedEntryId String?

  /// What it decided on: the content's hash, the citations' results, the
  /// neighbours it compared and the relations found, the writing run's issue.
  inputs       Json
  inputsDigest String
  /// Every model asked, in the order asked.
  models       String[] @default([])
  /// What each model answered, raw.
  outputs      Json?

  /// The decision it reached when agreement with people on decisions of
  /// that type had fallen under the floor (see KnowledgeBackoffChange). It
  /// is then recorded as ESCALATE with LOW_AGREEMENT, and agreement is still
  /// measured on what it reached, so a type that backed off can recover.
  backedOffFrom KnowledgeTriageDecisionType?

  /// Drawn for a person to check: a share of the decisions acted on without
  /// one, chosen by a draw seeded with the decision's id.
  audit     Boolean @default(false)
  /// The share it was drawn at, whenever a draw was made. An audited
  /// decision stands for 1/auditRate decisions when agreement is measured.
  auditRate Float?

  /// What a person did once the entry reached them: as an escalation, as a
  /// decision made in shadow mode, or as an audit. Null until then.
  verdict     KnowledgeVerdict?
  /// Whether the verdict agreed with the decision. Null without a verdict,
  /// and for a decision made by a rule a person's verdict says nothing about.
  agreed      Boolean?
  verdictById String?
  verdictAt   DateTime?

  @@index([entryId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, verdictAt])
}

/// A decision type stopping or resuming acting on its own in a workspace.
///
/// Appended whenever agreement is re-evaluated and a type's state changes,
/// never updated: the latest row for a type is its state, and the rows before
/// it are when and why it changed. A type with no row acts.
model KnowledgeBackoffChange {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  workspaceId String

  decision  KnowledgeTriageDecisionType
  /// True when the type stopped acting, false when it resumed.
  backedOff Boolean

  /// What it was decided on: kappa over the window (null where it is
  /// undefined), the verdicts it was measured over, and the settings then.
  kappa      Float?
  samples    Int
  floor      Float
  minSamples Int
  windowDays Int

  @@index([workspaceId, decision, createdAt])
}

/// Something the gardener did to an entry on its own, or asks a person to do,
/// and why.
///
/// Knowledge is kept true by changes nobody asked for at the time: a claim the
/// code now contradicts is taken out of use, a convention whose outcomes went
/// against it is disabled. Each is recorded with what it rested on, so a
/// person can see why an entry changed and undo it, and an undo is recorded
/// too. What the gardener may not do alone, archiving an entry a person
/// verified or one whose cited file is gone, is a proposal, which waits in the
/// review queue until a person accepts or declines it.
model PageEntryMaintenance {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String

  entry   PageEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String

  action PageEntryMaintenanceAction
  reason PageEntryMaintenanceReason
  /// What it rested on: the citation and the commit it was read at, the
  /// judge's reason, the counts and the margin, the window.
  evidence Json?

  /// The correction issue opened for a claim the code now contradicts.
  issueId String?

  /// A proposal's state: OPEN until a person accepts or declines it. Null for
  /// a change made alone.
  proposalState PageEntryProposalState?
  resolvedById  String?
  resolvedAt    DateTime?

  /// For a change made alone: when a person undid it, and who.
  reversedById String?
  reversedAt   DateTime?

  @@index([workspaceId, proposalState])
  @@index([entryId, action])
}

/// One reviewer finding in one agent run, placed in a module by the file it
/// points at.
///
/// A reviewer telling several runs the same thing about the same module is a
/// rule the module has that nobody wrote down, which is what a candidate
/// convention is made of. One row per run, module and finding, so distinct
/// runs can be counted; linked to the candidate once one is written, so the
/// same findings do not propose it twice.
model KnowledgeFinding {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  workspaceId String
  moduleId    String

  agentRun   AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  agentRunId String

  /// The reviewer's words, as it gave them.
  message String
  /// The message's words, lower-cased and without the common ones, which
  /// findings are compared by.
  words   String[]
  /// sha256 of the module and the words, so one run records a finding once.
  key     String

  /// The evidence as the reviewer gave it (`src/thing.ts:42`), and the file
  /// and line read from it.
  evidence String?
  path     String?
  line     Int?

  /// The candidate convention written from this finding and those like it.
  candidate   PageEntry? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  candidateId String?

  @@unique([agentRunId, key])
  @@index([workspaceId, moduleId, createdAt])
}

/// How one entry relates to another, as triage found it.
///
/// Relations are rows beside the entries, never edits to them: no entry's
/// text is changed because another resembles it. A DISTINCT pair is kept too,
/// as the record that the two were compared. A supersede a writer declares is
/// still `PageEntry.supersedesId`; a SUPERSEDES relation is triage's finding.
model PageEntryRelation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The newer entry, the one triage was deciding about.
  from   PageEntry @relation("PageEntryRelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  fromId String
  /// The existing entry it was compared with.
  to     PageEntry @relation("PageEntryRelationTo", fields: [toId], references: [id], onDelete: Cascade)
  toId   String

  type        PageEntryRelationType
  decidedBy   PageEntryRelationDecider
  /// The models that classified the pair, when models did.
  models      String[]                 @default([])
  /// 1 minus the vector distance between the two, when the index was asked.
  similarity  Float?
  /// For a contradiction or a supersede, the entry precedence prefers.
  preferredId String?
  reason      String?

  @@unique([fromId, toId])
  @@index([toId])
}

/// A question an agent asked that the bank could not answer.
///
/// The most valuable signal the system produces: it says which page to write
/// next, and it turns the bank from a record of what agents dumped into a
/// record of what agents needed.
///
/// Kept in postgres rather than in a typesense `nohits_queries` analytics rule,
/// which aggregates across the whole index with no workspace field — one
/// workspace's unanswered questions are not another's to read, and a query
/// string is often the most revealing thing about work in progress.
model PageKnowledgeGap {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Normalised query text, so "redis eviction" and "Redis  Eviction" are one
  /// gap rather than two.
  query String
  /// How many times it has been asked. Demand, not just absence.
  count Int    @default(1)

  workspaceId String

  /// The issue opened to answer it, once one is. A gap has at most one, so
  /// the job that opens them never opens a second for the same question.
  issueId    String?
  /// The module the question resolved to when its issue was opened, if one.
  moduleId   String?
  /// When an entry citing that issue was accepted, and which.
  answeredAt        DateTime?
  answeredByEntryId String?

  @@unique([workspaceId, query])
  @@index([workspaceId])
}

/// Who changed what on a page, mirroring IssueHistory.
model PageHistory {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  userId String?

  page   Page   @relation(fields: [pageId], references: [id])
  pageId String

  /// The change as a small JSON patch: `{ "title": { "from": …, "to": … } }`.
  changes Json?

  /// The body as it stood *before* this change, when this change touched it.
  ///
  /// Agents may rewrite a page wholesale to keep it current, which is the point
  /// — but a rewrite that cannot be seen or undone is not an edit, it is a
  /// replacement. The patch above recorded only that the body changed, so there
  /// was nothing to diff against and nothing to go back to. Kept as the same
  /// tiptap JSON `Page.description` holds, so a revert is a straight write.
  previousBody String?

  @@index([pageId])
}

/// A Product is a thing that the company ships. A Product holds no code and no
/// issues. It groups the modules.
///
/// A workspace is a tenancy. Before this model, a team was the only thing that
/// could stand for a product, and a company that shipped two things had to make
/// two workspaces. A Product takes that job from Team. Team keeps the other
/// three jobs: it is the permission boundary, it holds the cycles, and it is the
/// namespace for the issue numbers.
model Product {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name        String
  /// A short name, for example "cloud" or "docs".
  key         String
  description String?
  status      String?
  icon        String?
  color       String?
  leadUserId  String?

  modules Module[]

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  @@unique([workspaceId, key])
}

/// A Module is usually one repository. A Module can also be a path in a
/// repository, or one service.
///
/// Modules are flat: a Module has no parent Module. A parent column is one
/// nullable field and a recursive render if somebody needs it later. To add it
/// now makes every filter, every group, and every total choose between a subtree
/// and a single node, and no usage exists yet to answer that question.
model Module {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name        String
  /// A short name, for example "webapp" or "server".
  key         String
  description String?
  status      String?
  icon        String?
  color       String?
  leadUserId  String?

  /// A Module has one owner. Set ownerTeamId or ownerProductId. Do not set both,
  /// and do not leave both empty. A team owns a Module that holds internal tools,
  /// and that Module has no product. A product owns a Module that goes to the
  /// customers, and many teams can write the code for it. A check constraint in
  /// the migration makes this rule true in the database, because Prisma cannot
  /// say it here.
  ownerTeam      Team?    @relation("ModuleOwner", fields: [ownerTeamId], references: [id])
  ownerTeamId    String?
  ownerProduct   Product? @relation(fields: [ownerProductId], references: [id])
  ownerProductId String?

  /// These lists show the other teams and products that use this Module. A link
  /// gives no authority, and a list can be empty. Five teams can link to one
  /// Module, and no team owns it. One Module that holds a design system can link
  /// to three products.
  linkedTeamIds    String[]
  linkedProductIds String[]

  repos ModuleRepo[]

  /// How an agent run checks work in this module: setup, test, lint,
  /// typecheck and build commands, shaped as `AgentRunVerification`.
  ///
  /// Here rather than on the workspace because the command depends on the code
  /// and nothing else. One workspace holds a Go service and a pnpm monorepo,
  /// and there is no single `testCommand` that is right for both. A module is
  /// already what an agent run is grounded to — the issue names modules, the
  /// modules name the repository and the paths inside it — so the commands
  /// belong on the same hook, and an issue filed against a module arrives at a
  /// run that knows how to verify itself with nothing else configured.
  ///
  /// JSON rather than five columns because nothing queries by these, and
  /// because the set will grow.
  verification Json?

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  @@unique([workspaceId, key])
  @@index([workspaceId, ownerProductId])
  @@index([workspaceId, ownerTeamId])
}

/// Where the code of a Module is.
///
/// pathPrefixes is what makes a monorepo and a set of small repositories the
/// same shape. An empty list means that the Module is all of the repository. A
/// monorepo becomes several modules on one repository, and each one holds its
/// own prefixes.
///
/// The server uses this model, and the client does not. For each webhook, the
/// server reads this table. It finds the Module from the repository and from the
/// paths of the changed files. This model is not in the MODELS enum, and the
/// server does not replicate it. The module page reads it through a plain
/// request instead.
model ModuleRepo {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  module   Module @relation(fields: [moduleId], references: [id])
  moduleId String

  integrationAccountId String?
  /// The id that the provider gives the repository. A webhook arrives with it.
  externalRepoId       String
  fullName             String

  pathPrefixes  String[]
  bidirectional Boolean  @default(false)
  isDefault     Boolean  @default(false)

  /// Knowledge citing code in this repository.
  citations PageEntryCitation[]

  @@index([moduleId])
  @@index([externalRepoId])
}

/// A Capability is what the software does. A Module is where the code is.
///
/// The modules in moduleIds give a Capability its identity, because one
/// capability usually needs code in more than one Module. A Capability has no
/// product field. To find the product, read the owner of each Module in the
/// list.
model Capability {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name        String
  description String?
  /// planned, active, live, or deprecated.
  status      String?

  /// The modules that hold the code for this Capability. The list can be empty.
  /// An empty list means that no team wrote the code for this Capability yet.
  moduleIds String[]

  issues Issue[]

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  @@unique([workspaceId, name])
}

model Project {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name        String
  description String?
  status      String?
  startDate   String?
  endDate     String?
  leadUserId  String?
  teams       String[]

  /// The capabilities that this Project builds or changes. The list can be
  /// empty.
  capabilityIds String[]

  milestones ProjectMilestone[]
  issues     Issue[]
  history    ProjectHistory[]

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  @@unique([name, workspaceId])
}

model ProjectHistory {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  userId    String?
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  issueId   String
  issue     Issue   @relation(fields: [issueId], references: [id])

  changeType ProjectHistoryChangeType

  fromStateId  String?
  toStateId    String?
  fromEstimate Int?
  toEstimate   Int?
}

model ProjectMilestone {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name        String
  description String?
  endDate     String?

  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  issues Issue[]

  @@unique([name, projectId])
}

model Prompt {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name        String
  prompt      String
  // A role — "fast" or "smart" — not a model name. Which model serves each
  // role is deployment configuration (LLM_MODEL_FAST / LLM_MODEL_SMART), so
  // reaching a new model is not a schema change.
  model       String    @default("fast")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  @@unique([name, workspaceId])
}

model Reaction {
  id        String    @id @default(uuid())
  reactedAt DateTime  @default(now())
  deleted   DateTime?

  userId String

  comment   IssueComment @relation(fields: [commentId], references: [id])
  commentId String
  emoji     Emoji        @relation(fields: [emojiId], references: [id])
  emojiId   String

  @@unique([emojiId, commentId, userId])
}

model Support {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  reportedBy   People? @relation(fields: [reportedById], references: [id])
  reportedById String?

  slaStatus String?

  actualFrtAt     DateTime?
  firstResponseAt DateTime?
  nextResponseAt  DateTime?
  resolvedAt      DateTime?
  slaDueBy        DateTime?

  metadata Json?

  issue   Issue  @relation(fields: [issueId], references: [id])
  issueId String @unique
}

model SyncAction {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  modelName  ModelName
  modelId    String
  action     ActionType
  sequenceId BigInt

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  // The team that owns the announced record, when a team owns it. A team is a
  // visibility boundary, so a client reads only the actions of its own teams
  // and the actions that no team owns. A physically deleted row cannot be read
  // to find its team, so the log has to remember it.
  teamId String?

  @@unique([modelId, action])
  @@index([workspaceId, teamId, sequenceId])
}

model Team {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name       String
  identifier String
  icon       String?

  currentCycle Int?

  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  workspaceId String
  issue       Issue[]
  cycles      Cycle[]
  label       Label[]
  template    Template[]
  workflow    Workflow[]
  preferences Json       @default("{}")
  View        View[]

  /// The modules that this team owns. A team owns a Module that holds internal
  /// tools. A Module that goes to the customers belongs to a product instead.
  ownedModules Module[] @relation("ModuleOwner")

  @@unique([name, identifier, workspaceId])
}

model Template {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name         String
  category     TemplateCategory
  templateData Json

  createdBy   User      @relation(fields: [createdById], references: [id])
  createdById String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String
  team        Team?     @relation(fields: [teamId], references: [id])
  teamId      String?
}

model User {
  // Its own key. This used to be whatever id SuperTokens minted, which made
  // identity and credentials the same column and meant one person could hold
  // exactly one credential: a passkey and a login code for the same address
  // are two SuperTokens users, and only one of them could be this value.
  id String @id @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String   @unique

  /// What this account *is*, as opposed to what it may do in a given workspace.
  /// Role lives on the membership and is per workspace; an agent is an agent
  /// everywhere, and the UI badges it as non-human off this.
  type UserType @default(User)

  fullname                String?
  username                String
  initialSetupComplete    Boolean @default(false)
  anonymousDataCollection Boolean @default(false)

  image String?

  authIdentities      AuthIdentity[]
  usersOnWorkspaces   UsersOnWorkspaces[]
  template            Template[]
  integrationAccount  IntegrationAccount[]
  attachment          Attachment[]
  personalAccessToken PersonalAccessToken[]
  Conversation        Conversation[]
  ConversationHistory ConversationHistory[]
}

/// One way in to an account: a login code, a passkey, whatever comes later.
/// SuperTokens owns the credential and issues a recipe user id per method, so
/// somebody with both a passkey and a login code has two rows here pointing at
/// one User. This is the table account linking would have been paying for.
model AuthIdentity {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// SuperTokens recipe id: `passwordless`, `webauthn`.
  provider String

  /// The recipe user id SuperTokens issued. Sessions arrive carrying this, and
  /// minting one for a personal access token needs it back.
  supertokensUserId String @unique

  @@unique([userId, provider])
  @@index([userId])
}

model UsersOnWorkspaces {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String
  workspaceId String
  teamIds     String[]
  status      Status    @default(ACTIVE)
  settings    Json      @default("{}")

  externalAccountMappings Json?
  role                    Role      @default(ADMIN)
  joinedAt                DateTime?

  @@unique([userId, workspaceId])
}

model View {
  id        String    @id @default(uuid())
