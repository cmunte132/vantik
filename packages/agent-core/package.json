{
  "name": "@vantikhq/agent-core",
  "version": "0.1.0",
  "description": "Task-shaped Vantik operations shared by the CLI and the MCP server",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "tsup --watch",
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:tsup",
    "build:tsup": "tsup --dts-resolve",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "devDependencies": {
    "@vantikhq/eslint-config": "workspace:*",
    "@vantikhq/typescript-config": "workspace:*",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
