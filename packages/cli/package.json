{
  "name": "@vantikhq/cli",
  "version": "0.1.15",
  "description": "Work Vantik issues, projects and pages from the terminal",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/vantikhq/vantik.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": "./dist/index.js",
  "bin": {
    "vantik": "./dist/index.js"
  },
  "devDependencies": {
    "@vantikhq/eslint-config": "workspace:*",
    "@types/node": "18",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "open": "^10.0.3",
    "p-retry": "^6.2.0",
    "rimraf": "^5.0.7",
    "tsup": "^8.0.1",
    "type-fest": "^3.6.0",
    "typescript": "^5.3.3",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "pnpm run clean && pnpm run build:main",
    "build:main": "tsup",
    "dev:cli": "npm run clean && pnpm run dev:main",
    "dev:main": "tsup --watch",
    "clean": "rimraf dist",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@vantikhq/agent-core": "workspace:*",
    "axios": "^1.6.7",
    "chalk": "^5.2.0",
    "cli-table3": "^0.6.3",
    "commander": "^9.4.1",
    "esbuild": "^0.25.0",
    "std-env": "^3.7.0",
    "xdg-app-paths": "^8.3.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
