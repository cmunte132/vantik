{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "VERSION",
    // Part of the hash, not just passed through. The build stamp is baked into
    // the bundle, so a cached build replayed under a new stamp would ship the
    // old build id and defeat the whole mechanism.
    "VANTIK_BUILD_ID",
    "VANTIK_COMMIT",
    "NODE_ENV",
    "NEXT_PUBLIC_BACKEND_HOST",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_SENTRY_DSN",
    // Turns on the source map upload in vite.config.ts. Turbo hands a task only
    // the variables listed here, so without this line the image build's token
    // never reached the build, and the upload was silently skipped.
    "SENTRY_AUTH_TOKEN",
    "LOG_LEVEL",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "OTEL_METRIC_EXPORT_INTERVAL",
    "OTEL_LOG_LEVEL",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "DB_HOST",
    "DB_PORT",
    "DB_SCHEMA",
    "DATABASE_URL",
    "PASSKEY_SIGNUP_ENABLED",
    "IMPERSONATION_KEY",
    "REDIS_URL",
    "REDIS_PORT",
    "PORT",
    "FRONTEND_HOST",
    "BACKEND_HOST",
    "BACKEND_URL",
    "PUBLIC_ATTACHMENT_URL",
    "BASE_HOST",
    "OAUTH_CALLBACK_URL",
    "EMBEDDINGS_SOURCE",
    "EMBEDDINGS_MODEL",
    "EMBEDDINGS_BASE_URL",
    "EMBEDDINGS_API_KEY",
    "STORAGE_PROVIDER",
    "BUCKET_NAME",
    "LOCAL_STORAGE_PATH",
    "ATTACHMENT_URL_SECRET",
    "CREDENTIAL_ENCRYPTION_KEY",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "TEST_S3_ENDPOINT",
    "TEST_S3_REGION",
    "TEST_S3_ACCESS_KEY_ID",
    "TEST_S3_SECRET_ACCESS_KEY",
    "TEST_S3_BUCKET",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "SMTP_DEFAULT_FROM",
    "SMTP_USE_SLS",
    "LLM_BASE_URL",
    "LLM_API_KEY",
    "LLM_MODEL_FAST",
    "LLM_MODEL_SMART",
    "LLM_APP_URL",
    "LLM_APP_NAME",
    "MCP_LOOPBACK_URL",
    "MCP_RATE_LIMIT",
    "MCP_RATE_LIMIT_WINDOW_MS",
    // Tunables the server reads at import time. Each has a default; these let
    // an operator override it.
    "AGENT_RUN_EVENT_CAP",
    "AGENT_RUN_LEASE_MS",
    "AGENT_RUN_LEASE_SWEEP_CRON",
    "AGENT_RUN_MAX_ATTEMPTS",
    "AGENT_RUN_WORKSPACE_CONCURRENCY",
    // The server's way to the sandbox host, and the sandbox host's settings.
    "SANDBOX_HOST_URL",
    "SANDBOX_HOST_TOKEN",
    "SANDBOX_HOST_PORT",
    "SANDBOX_HOST_BIND",
    "SANDBOX_HOST_IDLE_MS",
    "SANDBOX_HOST_GRACE_MS",
    "SANDBOX_HOST_MAX_BODY_MB",
    "CYCLE_MAINTENANCE_CRON",
    "PAGE_DECAY_CRON",
    "KNOWLEDGE_GAP_ISSUES_CRON",
    "PAGE_PROPOSED_ENTRY_BUDGET",
    "PAGE_PROPOSED_ENTRY_EXPIRY_DAYS",
    "PAGE_PROVISIONAL_ENTRY_DECAY_DAYS",
    "PAGE_STANDING_ENTRY_DECAY_DAYS",
    "KNOWLEDGE_HOLDOUT_RATE",
    "KNOWLEDGE_CONTEXT_TOP_K",
    "KNOWLEDGE_CONTEXT_TOKEN_BUDGET",
    "KNOWLEDGE_AUTO_TRIAGE",
    "KNOWLEDGE_SIMILARITY_THRESHOLD",
    "KNOWLEDGE_AUDIT_RATE",
    "KNOWLEDGE_KAPPA_FLOOR",
    "KNOWLEDGE_KAPPA_MIN_SAMPLES",
    "KNOWLEDGE_KAPPA_WINDOW_DAYS",
    "KNOWLEDGE_CONVENTION_MIN_RUNS",
    "KNOWLEDGE_CONVENTION_HARM_MARGIN",
    "KNOWLEDGE_GAP_ISSUE_MIN_COUNT",
    "KNOWLEDGE_PAGE_REFRESH_MIN_INTERVAL",
    "KNOWLEDGE_PAGE_REFRESH_CRON",
    // The directory that holds every local repository. It is empty on a
    // machine that one person runs, and then any absolute path is allowed.
    "LOCAL_REPO_ROOT",
    "REPO_MIRROR_ROOT",
    // The seed of the integration definitions reads these pairs. A pair that
    // the environment does not hold leaves its integration without
    // credentials, and the settings page says so.
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "EMAIL_CLIENT_ID",
    "EMAIL_CLIENT_SECRET",
    "VANTIK_URL",
    "VANTIK_TOKEN",
    "APOLLO_API_KEY"
  ],
  "ui": "tui",
  "tasks": {
    "start-prod": {
      "dependsOn": [
        "db:init-resources"
      ],
      "cache": false
    },
    "generate": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false
    },
    "dev": {
      "dependsOn": [
        "generate"
      ],
      "interactive": true,
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "create-resources": {
      "interactive": true,
      "cache": false
    },
    "prisma:studio": {
      "env": [
        "DATABASE_URL"
      ]
    },
    "migrate": {
      "env": [
        "DATABASE_URL"
      ],
      "interactive": true,
      "cache": false
    }
  }
}
