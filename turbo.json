{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "VERSION",
    "NEXT_PUBLIC_VERSION",
    // Part of the hash, not just passed through. The build stamp is baked into
    // the bundle and into the chunk namespace, so a cached build replayed under
    // a new stamp would ship the old build id and defeat the whole mechanism.
    "VANTIK_BUILD_ID",
    "VANTIK_COMMIT",
    "NODE_ENV",
    "NEXT_RUNTIME",
    "NEXT_PUBLIC_BACKEND_HOST",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_SENTRY_DSN",
    "LOG_LEVEL",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "OTEL_METRIC_EXPORT_INTERVAL",
    "OTEL_LOG_LEVEL",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "DB_HOST",
    "DB_PORT",
    "DB_SCHEMA",
    "DATABASE_URL",
    "REPLICATION_DATABASE_URL",
    "SYNC_SERVER",
    "SUPERTOKEN_CONNECTION_URI",
    "SUPERTOKENS_DOMAIN",
    "PASSKEY_SIGNUP_ENABLED",
    "SENTRY_DSN",
    "REDIS_URL",
    "REDIS_PORT",
    "PORT",
    "FRONTEND_HOST",
    "BACKEND_HOST",
    "BACKEND_URL",
    "CHAT_URL",
    "PUBLIC_ATTACHMENT_URL",
    "BASE_HOST",
    "OAUTH_CALLBACK_URL",
    "TYPESENSE_HOST",
    "TYPESENSE_PORT",
    "TYPESENSE_PROTOCOL",
    "TYPESENSE_API_KEY",
    "STORAGE_PROVIDER",
    "BUCKET_NAME",
    "GCP_SERVICE_ACCOUNT_FILE",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "SMTP_DEFAULT_FROM",
    "SMTP_USE_SLS",
    "LLM_BASE_URL",
    "LLM_API_KEY",
    "LLM_MODEL_FAST",
    "LLM_MODEL_SMART",
    "LLM_APP_URL",
    "LLM_APP_NAME",
    "MCP_LOOPBACK_URL",
    "MCP_RATE_LIMIT",
    "MCP_RATE_LIMIT_WINDOW_MS",
    // The directory that holds every local repository. It is empty on a
    // machine that one person runs, and then any absolute path is allowed.
    "LOCAL_REPO_ROOT",
    // The seed of the integration definitions reads these pairs. A pair that
    // the environment does not hold leaves its integration without
    // credentials, and the settings page says so.
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "EMAIL_CLIENT_ID",
    "EMAIL_CLIENT_SECRET",
    "WHATSAPP_CLIENT_ID",
    "WHATSAPP_CLIENT_SECRET",
    "WHATSAPP_BUSINESS_CLIENT_ID",
    "WHATSAPP_BUSINESS_CLIENT_SECRET",
    "VANTIK_URL",
    "VANTIK_TOKEN",
    "TRIGGER_DB",
    "TRIGGER_DATABASE_URL",
    "TRIGGER_COMMON_ID",
    "TRIGGER_TOKEN",
    "TRIGGER_ACCESS_TOKEN",
    "TRIGGER_SECRET_KEY",
    "TRIGGER_API_URL",
    "APOLLO_API_KEY"
  ],
  "ui": "tui",
  "tasks": {
    "start-prod": {
      "dependsOn": [
        "db:init-resources"
      ],
      "cache": false
    },
    "generate": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false
    },
    "dev": {
      "dependsOn": [
        "generate"
      ],
      "interactive": true,
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "create-resources": {
      "interactive": true,
      "cache": false
    },
    "trigger-deploy": {
      "cache": false
    },
    "trigger-dev": {
      "interactive": true,
      "cache": false
    },
    "prisma:studio": {
      "env": [
        "DATABASE_URL"
      ]
    },
    "migrate": {
      "env": [
        "DATABASE_URL"
      ],
      "interactive": true,
      "cache": false
    }
  }
}
